<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Same HTTPS-only base as the release config, plus one
  cleartext exception: 10.0.2.2, the emulator's alias for the host machine.
  CI's Maestro job signs in to an engine it starts on the runner there; a
  release APK never contains this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
