<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the NeuraOS emblem (assets/branding/neuraos-emblem.svg).

  An adaptive icon is 108x108dp, but a launcher may mask it to a circle,
  squircle or rounded square, and only the centre 72x72dp is guaranteed to
  survive every mask. The emblem is drawn in a 64-unit box and scaled 1.1
  about the origin, then moved 18.8 so its centre (32,32) lands on (54,54).
  Its furthest point, the outer edge of a corner node, then sits 28.9dp from
  the centre: inside the 33dp keyline Android's icon guidelines recommend,
  and well inside the 36dp circle mask.

  The outer 18dp on each side stays empty on purpose: that is the parallax
  margin launchers shift the layers within.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:translateX="18.8"
        android:translateY="18.8">
        <path
            android:pathData="M18,46V18L46,46V18"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="12"
                    android:startY="52"
                    android:endX="52"
                    android:endY="12">
                    <item android:offset="0" android:color="#FF8B6CFF" />
                    <item android:offset="0.45" android:color="#FF8B6CFF" />
                    <item android:offset="1" android:color="#FF22D3EE" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M11.5,46a6.5,6.5 0 1,0 13,0a6.5,6.5 0 1,0 -13,0ZM11.5,18a6.5,6.5 0 1,0 13,0a6.5,6.5 0 1,0 -13,0ZM39.5,46a6.5,6.5 0 1,0 13,0a6.5,6.5 0 1,0 -13,0ZM39.5,18a6.5,6.5 0 1,0 13,0a6.5,6.5 0 1,0 -13,0Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="12"
                    android:startY="52"
                    android:endX="52"
                    android:endY="12">
                    <item android:offset="0" android:color="#FF8B6CFF" />
                    <item android:offset="0.45" android:color="#FF8B6CFF" />
                    <item android:offset="1" android:color="#FF22D3EE" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
