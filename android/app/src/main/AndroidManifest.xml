<?xml version="1.0" encoding="utf-8"?>
<!--
  NeuraOS Android app: a native Kotlin/Compose client for the NeuraOS
  server, with a native sign-in that keeps the phone logged in. Security
  posture:
  - Permissions: INTERNET, ACCESS_NETWORK_STATE, USE_BIOMETRIC and SET_ALARM
    are install-time "normal" permissions. RECORD_AUDIO (voice mode) and
    POST_NOTIFICATIONS (reply ready) are runtime permissions asked for in
    context; no location, contacts, SMS, call or storage permission. Files come in through
    the system picker or the share sheet and go out through MediaStore,
    neither of which needs storage access.
  - No backup (adb or cloud) can lift the server, the sealed password, the
    session, or the chats the page keeps in its own storage.
  - Exported: the native launcher activity, which also accepts shared text,
    shared images and selected text (all treated as untrusted input that only
    ever lands in a chat composer), a neuraos://github-connected deep link
    (a one-time pickup code from the server's own GitHub OAuth callback,
    never a session -- see server.js and data/NativeApi.kt), and the Quick
    Settings tile, which only the system can bind. The FileProvider is not
    exported.
  - Chats, pictures, personas and prompts are sealed with a Keystore
    AES-256-GCM key in app-private storage (data/Storage.kt).
  - Cleartext is off here AND refused in code (Api.normalizeBaseUrl): chat
    content never crosses the network unencrypted.
  - The only WebView left is the hidden Puter drawing page, locked down in
    WebShell.kt: no file or content URLs, no JavaScript bridge, no
    geolocation, mixed content refused; the page is never given a handle
    into the app.
  - FcmService (push for a build waiting on your approval) is declared
    unconditionally but does nothing unless the build was compiled with a
    real Firebase project's google-services.json; see app/build.gradle.kts.
  - DeviceControlService (data/Agent.kt's tap_text/scroll_until phone
    actions) is a BIND_ACCESSIBILITY_SERVICE, declared here deliberately and
    visibly; see RatchetTest for why it's the one exception to this app's
    "no device-control permission" rule everywhere else. It is off by
    default: Android will not enable it until the person turns it on by
    hand in Settings > Accessibility, and even then every action still
    waits for a tap in the chat before it runs anything (see
    data/Agent.kt's ActionTicket). It never draws an overlay on top of
    other apps and reads the accessibility tree, never a screenshot.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Voice mode only; asked for the first time voice mode opens. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Normal permission: lets a tapped "Set alarm" button hand off to the Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Reply ready" when a reply finishes in the background (Android 13+ asks once). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app update installs (NativeActivity.downloadUpdate): the system
         installer still verifies the APK signature and the user still grants
         "Install unknown apps" per-app; without this declaration the install
         intent silently does nothing and a good download looks broken. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Keeps a streaming reply alive while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Package visibility for the phone's own speech services (targetSdk 30+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_app"
        android:label="NeuraOS"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeuraOS"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- "Ask NeuraOS" in the text-selection menu of other apps. -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Where the server's GitHub OAuth callback lands the app after a
                 Custom Tab round trip (see server.js's githubCallback): a
                 one-time pickup code, never a session, in the query. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neuraos" android:host="github-connected" />
            </intent-filter>
        </activity>
        <!-- Share / PDF exports: private cache files handed out one at a time
             with a temporary read grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".app.NewChatTileService"
            android:exported="true"
            android:icon="@drawable/ic_app"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Holds the process open while a reply streams; started only while
             the app is in the foreground, so no background-start exemption is
             needed. -->
        <service
            android:name=".app.ReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Instant build-approval push (see FcmService.kt). Only Firebase
             itself can bind this, and Firebase never delivers anything here
             unless the build was compiled with a real google-services.json,
             so declaring it costs nothing on a build that has none. -->
        <service
            android:name=".app.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    <!-- Off until the person turns it on in Settings > Accessibility.
         Only the system can bind it (BIND_ACCESSIBILITY_SERVICE); it
         reads the accessibility tree and taps/scrolls elements by their
         label, never a screenshot or a raw coordinate, and only after a
         tap in the chat approves the specific action (data/Agent.kt).
         NeuraOS device control for phone automation. -->
        <service
            android:name=".app.DeviceControlService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/device_control_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/device_control_service_config" />
        </service>
    </application>
</manifest>
