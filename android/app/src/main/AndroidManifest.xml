<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeAI4U Android app: the deployed web app in a hardened WebView, with a
  native sign-in that keeps the phone logged in. Security posture:
  - Permissions: INTERNET, ACCESS_NETWORK_STATE (retry when the connection
    returns) and USE_BIOMETRIC (the optional app lock). All three are
    install-time "normal" permissions with no prompt. Files come in through
    the system picker or the share sheet and go out through MediaStore,
    neither of which needs storage access.
  - No backup (adb or cloud) can lift the server, the sealed password, the
    session, or the chats the page keeps in its own storage.
  - Exported: the launcher activity, which also accepts shared text and
    images (treated as untrusted: text is percent-encoded into a fragment,
    images only reach the page's own file picker), and the Quick Settings
    tile, which only the system can bind.
  - Cleartext is off here AND refused in code (Api.normalizeBaseUrl): chat
    content never crosses the network unencrypted.
  - The WebView itself is locked down in WebShell.kt: no file or content
    URLs, no JavaScript bridge, no geolocation, mixed content refused, and
    navigation held to the configured server.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_app"
        android:label="FreeAI4U"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeAI4U"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".NewChatTileService"
            android:exported="true"
            android:icon="@drawable/ic_app"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
