{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "longDescription": "FreeAI4U Desktop — native Windows app for FreeAI4U",
    "shortDescription": "FreeAI4U Desktop",
    "category": "productivity",
    "fileAssociations": []
  },
  "productName": "FreeAI4U Desktop",
  "version": "2.0.0",
  "identifier": "com.freeai4u.desktop",
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "FreeAI4U Desktop",
        "width": 1360,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
