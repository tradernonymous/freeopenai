{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "longDescription": "FreeAI4U Desktop — the free AI desktop: chat, images and builds on free models.",
    "shortDescription": "FreeAI4U Desktop",
    "category": "productivity",
    "fileAssociations": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "productName": "FreeAI4U Desktop",
  "version": "2.1.0",
  "identifier": "com.freeai4u.desktop",
  "plugins": {
    "window-state": {},
    "store": {}
  },
  "app": {
    "windows": [
      {
        "title": "FreeAI4U Desktop",
        "width": 1360,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
