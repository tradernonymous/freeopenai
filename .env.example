# OmniRoute + Cloudflare Tunnel configuration
# Copy this file to .env and fill in your values

# OmniRoute settings
INITIAL_PASSWORD=change-me-strong-password
JWT_SECRET=generate-with: openssl rand -base64 32
API_KEY_SECRET=generate-with: openssl rand -base64 32
REQUIRE_API_KEY=true

# Cloudflare Tunnel token (get from https://one.dash.cloudflare.com → Access → Tunnels → click tunnel → Connectors)
# Leave EMPTY for the quick tunnel (https://xxx.trycloudflare.com) which needs no token.
# Fill it in for a permanent URL: it is the long string after --token in the connector command (starts with eyJ...)
TUNNEL_TOKEN=