# OmniRoute + Cloudflare Tunnel configuration
# Copy this file to .env and fill in your values

# OmniRoute settings
INITIAL_PASSWORD=change-me-strong-password
JWT_SECRET=generate-with: openssl rand -base64 32
API_KEY_SECRET=generate-with: openssl rand -base64 32
REQUIRE_API_KEY=true

# Cloudflare Tunnel token (get from https://one.dash.cloudflare.com → Access → Tunnels → click tunnel → Connectors)
# Leave EMPTY for the quick tunnel (https://xxx.trycloudflare.com) which needs no token.
# Fill it in for a permanent URL: it is the long string after --token in the connector command (starts with eyJ...)
TUNNEL_TOKEN=
# --- Rovo Dev gateway (docker compose --profile rovo up -d --build) ---
# Claude Sonnet 4 on your Atlassian account's own daily allowance.
#
# Two different secrets, and they must not be the same value:
#   ROVO_API_TOKEN authenticates this container TO Atlassian (your credential)
#   ROVO_API_KEY   authenticates callers TO this container (what the app sends)
# The second is what stops a tunnelled URL from being an open door to your
# allowance, so the container refuses to start without it.
ROVO_EMAIL=you@example.com
# Create at id.atlassian.com -> Security -> API tokens
ROVO_API_TOKEN=
# Any long random string: openssl rand -base64 32
ROVO_API_KEY=
