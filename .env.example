# OmniRoute + Cloudflare Tunnel configuration
# Copy this file to .env and fill in your values

# OmniRoute settings
INITIAL_PASSWORD=change-me-strong-password
JWT_SECRET=generate-with: openssl rand -base64 32
API_KEY_SECRET=generate-with: openssl rand -base64 32
REQUIRE_API_KEY=true

# Cloudflare Tunnel token (get from https://one.dash.cloudflare.com → Access → Tunnels → Create tunnel)
# Leave empty for quick trycloudflare.com URL (not persistent across restarts)
TUNNEL_TOKEN=