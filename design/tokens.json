{
  "$description": "NeuraOS design tokens (docs/neuraos-rebrand-plan.md, R0). The one source of truth for colour, shape and motion on the web page, the desktop app and the Android app. Edit this file, then run `npm run tokens`; test/tokens.test.js fails when a generated file is stale or a text colour drops below WCAG AA. Format: W3C Design Tokens (DTCG).",
  "color": {
    "dark": {
      "bg": { "$type": "color", "$value": "#0A0B10", "$description": "Page background: near-black ink" },
      "surface": { "$type": "color", "$value": "#12141B", "$description": "Cards, sheets, the composer" },
      "raised": { "$type": "color", "$value": "#1A1D26", "$description": "Chips, inputs, anything on a surface" },
      "line": { "$type": "color", "$value": "#6B7385", "$description": "Control boundaries: 3:1 on every surface" },
      "text": { "$type": "color", "$value": "#ECEEF4" },
      "muted": { "$type": "color", "$value": "#9AA1B2" },
      "accent": { "$type": "color", "$value": "#8B6CFF", "$description": "Neural Violet: the AI and primary actions, never a status" },
      "onAccent": { "$type": "color", "$value": "#1B0F4D", "$description": "Text and icons on an accent fill" },
      "accentSoft": { "$type": "color", "$value": "#241C4A", "$description": "Accent-tinted surface: selected rows, the user's bubble" },
      "accentDeep": { "$type": "color", "$value": "#4C35C4", "$description": "Filled accent containers that carry ordinary text" },
      "glow": { "$type": "color", "$value": "#22D3EE", "$description": "Second stop of the AI-activity gradient (accent -> glow)" },
      "success": { "$type": "color", "$value": "#3FB950" },
      "warning": { "$type": "color", "$value": "#E3B341", "$description": "Needs you" },
      "danger": { "$type": "color", "$value": "#F85149" },
      "info": { "$type": "color", "$value": "#58A6FF" },
      "code": { "$type": "color", "$value": "#07080C" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#FAFAFB" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "raised": { "$type": "color", "$value": "#EEF0F4" },
      "line": { "$type": "color", "$value": "#7A8396" },
      "text": { "$type": "color", "$value": "#0E1116" },
      "muted": { "$type": "color", "$value": "#525A6B" },
      "accent": { "$type": "color", "$value": "#6D4DF2" },
      "onAccent": { "$type": "color", "$value": "#FFFFFF" },
      "accentSoft": { "$type": "color", "$value": "#ECE7FF" },
      "accentDeep": { "$type": "color", "$value": "#D9D0FF" },
      "glow": { "$type": "color", "$value": "#0891B2" },
      "success": { "$type": "color", "$value": "#1A7F37" },
      "warning": { "$type": "color", "$value": "#9A6700" },
      "danger": { "$type": "color", "$value": "#CF222E" },
      "info": { "$type": "color", "$value": "#0969DA" },
      "code": { "$type": "color", "$value": "#F3F4F7" }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" }
  },
  "motion": {
    "springStiffness": { "$type": "number", "$value": 380, "$description": "Material 3 Expressive 'fast spatial' spring" },
    "springDamping": { "$type": "number", "$value": 0.8 },
    "fast": { "$type": "duration", "$value": "150ms", "$description": "Colour and opacity changes" },
    "pulse": { "$type": "duration", "$value": "1600ms", "$description": "One cycle of the NeuraOS pulse (the AI is working)" }
  }
}
