// Probe `prompt-assembly`: the messages the app builds before any model sees
// them (desktop/src/research.js planMessages / synthesisMessages /
// noSourcesMessages). `date` is fixed in every case so the run is repeatable.
// A rule silently dropped from a system prompt is exactly the regression this
// harness exists to catch.
{"id": "plan-prompt-asks-for-json-only", "probe": "prompt-assembly", "input": {"kind": "plan", "question": "how do heat pumps work", "date": "2026-01-15T12:00:00.000Z", "mustInclude": ["Reply with JSON only", "{\"queries\": [\"...\", \"...\"]}", "3 to 5", "Today is 2026-01-15", "how do heat pumps work"]}, "expect": {"roles": ["system", "user"], "missingPhrases": [], "forbiddenPhrases": []}}
{"id": "synthesis-prompt-keeps-its-citation-rules", "probe": "prompt-assembly", "input": {"kind": "synthesis", "question": "how do heat pumps work", "date": "2026-01-15T12:00:00.000Z", "sources": [{"n": 1, "title": "Heat pumps explained", "url": "https://example.org/heat-pumps", "snippet": "How a heat pump moves heat."}], "mustInclude": ["Use ONLY the numbered sources below", "Cite every claim with the source number in square brackets", "Do not write a sources or references list at the end", "[1]", "https://example.org/heat-pumps"]}, "expect": {"roles": ["system", "user"], "missingPhrases": [], "forbiddenPhrases": []}}
{"id": "synthesis-prompt-carries-the-page-text-it-read", "probe": "prompt-assembly", "input": {"kind": "synthesis", "question": "how do heat pumps work", "date": "2026-01-15T12:00:00.000Z", "sources": [{"n": 1, "title": "Heat pumps explained", "url": "https://example.org/heat-pumps", "snippet": "How a heat pump moves heat."}], "pages": {"1": "A heat pump uses a refrigerant cycle to move heat from cold to warm."}, "mustInclude": ["refrigerant cycle to move heat"]}, "expect": {"roles": ["system", "user"], "missingPhrases": []}}
