{"id": "two-calls-interleaved-by-index", "probe": "tool-calls", "input": {"chunks": [[{"index": 0, "id": "c0", "function": {"name": "read_file", "arguments": "{\"path\":"}}, {"index": 1, "id": "c1", "function": {"name": "run_command", "arguments": "{\"comm"}}], [{"index": 1, "function": {"arguments": "and\":\"npm test\"}"}}, {"index": 0, "function": {"arguments": " \"src/app.js\"}"}}]]}, "expect": {"calls": [{"name": "read_file", "args": {"path": "src/app.js"}}, {"name": "run_command", "args": {"command": "npm test"}}], "summaries": ["Read src/app.js", "Run: npm test"], "needsApproval": ["", "runs a command on this PC"]}}
