// Probe `citations`: research mode's numbering (desktop/src/research.js
// parseSearchResults -> addSources) and what it does with a scripted answer
// (checkCitations, linkCitations). The numbers are the app's contract with the
// reader: [3] must be the third source in the list it prints, always.
{"id": "search-output-becomes-numbered-sources", "probe": "citations", "input": {"searchOutput": "Heat pumps explained\nhttps://example.org/heat-pumps\nHow a heat pump moves heat.\n\nHeat pump efficiency\nhttps://example.com/efficiency\nWhat COP means."}, "expect": {"numbers": [1, 2], "urls": ["https://example.org/heat-pumps", "https://example.com/efficiency"]}}
{"id": "a-repeat-url-does-not-take-a-new-number", "probe": "citations", "input": {"sources": [{"n": 1, "title": "Heat pumps explained", "url": "https://example.org/heat-pumps", "snippet": ""}], "searchOutput": "Heat pumps explained (mirror)\nhttps://www.example.org/heat-pumps?utm_source=x\nsame page\n\nHeat pump efficiency\nhttps://example.com/efficiency\nWhat COP means."}, "expect": {"numbers": [1, 2], "urls": ["https://example.org/heat-pumps", "https://example.com/efficiency"]}}
{"id": "an-invented-citation-is-stripped-and-reported", "probe": "citations", "input": {"sources": [{"n": 1, "title": "Heat pumps explained", "url": "https://example.org/heat-pumps", "snippet": ""}, {"n": 2, "title": "Heat pump efficiency", "url": "https://example.com/efficiency", "snippet": ""}], "answer": "Heat pumps move heat rather than making it [1]. Efficiency is measured as COP [2]. An invented claim [5]."}, "expect": {"cited": [1, 2], "unknown": [5], "cleaned": "Heat pumps move heat rather than making it [1]. Efficiency is measured as COP [2]. An invented claim.", "linked": "Heat pumps move heat rather than making it [1](https://example.org/heat-pumps). Efficiency is measured as COP [2](https://example.com/efficiency). An invented claim [5]."}}
{"id": "a-long-uncited-paragraph-is-flagged", "probe": "citations", "input": {"sources": [{"n": 1, "title": "Heat pumps explained", "url": "https://example.org/heat-pumps", "snippet": ""}], "answer": "A heat pump moves heat instead of making it [1].\n\nIn my own experience the installers always arrive late and leave the old radiators behind, which nobody warns you about."}, "expect": {"cited": [1], "unknown": [], "uncitedCount": 1}}
{"id": "a-markdown-link-is-not-a-citation", "probe": "citations", "input": {"sources": [{"n": 1, "title": "Heat pumps explained", "url": "https://example.org/heat-pumps", "snippet": ""}], "answer": "See the [1](https://elsewhere.example/page) guide [1]."}, "expect": {"cited": [1], "unknown": [], "linked": "See the [1](https://elsewhere.example/page) guide [1](https://example.org/heat-pumps)."}}
