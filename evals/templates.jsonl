// Probe `template`: which saved recipe a `/recipe ...` line selects and what
// prompt it fills (desktop/src/recipes.js parseCommand, fillTemplate,
// placeholders). A named value wins over the parameter's default; a loose word
// fills the first parameter still empty; an unfilled placeholder is reported
// rather than sent to the model as "{{topic}}".
{"id": "named-value-beats-the-default", "probe": "template", "input": {"command": "daily-brief topic=rust", "params": [{"name": "topic", "label": "Topic", "default": "general"}], "prompt": "Write a short brief about {{topic}}."}, "expect": {"id": "daily-brief", "values": {"topic": "rust"}, "text": "Write a short brief about rust.", "missing": [], "placeholders": ["topic"]}}
{"id": "the-default-fills-an-omitted-parameter", "probe": "template", "input": {"command": "daily-brief", "params": [{"name": "topic", "label": "Topic", "default": "general"}], "prompt": "Write a short brief about {{topic}}."}, "expect": {"id": "daily-brief", "values": {}, "text": "Write a short brief about general.", "missing": []}}
{"id": "a-loose-phrase-fills-the-first-open-parameter", "probe": "template", "input": {"command": "daily-brief the rust release notes", "params": [{"name": "topic", "label": "Topic", "default": ""}], "prompt": "Write a short brief about {{topic}}."}, "expect": {"id": "daily-brief", "values": {"topic": "the rust release notes"}, "text": "Write a short brief about the rust release notes."}}
{"id": "a-quoted-value-keeps-its-spaces", "probe": "template", "input": {"command": "daily-brief topic=\"rust and go\"", "params": [{"name": "topic", "label": "Topic", "default": ""}], "prompt": "Write a short brief about {{topic}}."}, "expect": {"id": "daily-brief", "values": {"topic": "rust and go"}, "text": "Write a short brief about rust and go."}}
{"id": "an-unfilled-placeholder-is-reported-not-pasted", "probe": "template", "input": {"command": "daily-brief", "params": [{"name": "topic", "label": "Topic", "default": ""}], "prompt": "Write a short brief about {{topic}} for {{audience}}."}, "expect": {"text": "Write a short brief about  for .", "missing": ["topic", "audience"], "placeholders": ["topic", "audience"]}}
